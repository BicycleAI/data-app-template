{
  "version": 2,
  "model": "RGfoyOBb",
  "title": "Hotel Failure Watch",
  "decision": "Which brand owners and failure types are driving booking failures, and is any of them trending?",
  "persona": "analyst",
  "template": "explorer",
  "time": { "column": "timestamp", "from": "2026-08-01", "to": "tomorrow", "grain": "day" },
  "measures": [
    { "id": "failed", "column": "total_failed_bookings_v2", "label": "Failed bookings", "format": "number", "good": "down", "role": "primary" },
    { "id": "failure_rate", "column": "total_booking_failure_rate_overall_v2", "label": "Failure rate", "format": "rate", "good": "down" },
    { "id": "successful", "column": "total_successful_bookings_v2", "label": "Successful bookings", "format": "number", "good": "up" }
  ],
  "dimensions": [
    { "field": "brand_owner_name_grouped", "label": "Brand owner" },
    { "field": "failureType", "label": "Failure type" },
    { "field": "city_name", "label": "City" }
  ],
  "questions": [
    { "say": "How big is the failure problem, and which way is it moving?", "recipe": "kpis" },
    { "say": "How has it moved, split by brand owner?", "recipe": "trend", "bind": { "by": "brand_owner_name_grouped" } },
    { "say": "How has it moved, split by failure type?", "recipe": "trend", "bind": { "by": "failureType" } },
    { "say": "Which brand owners fail most?", "recipe": "breakdown", "bind": { "dims": ["brand_owner_name_grouped"], "limit": 10 } },
    { "say": "What happens where brand owner meets failure type?", "recipe": "heatmap", "bind": { "rows": "brand_owner_name_grouped", "cols": "failureType" } }
  ],
  "controls": [ { "kind": "measure" }, { "kind": "dimensions" }, { "kind": "heatmap_axes" } ],
  "rules": { "compare_periods": 7 },
  "theme": { "accent": "coral", "follow": "system" }
}
