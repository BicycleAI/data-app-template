{
  "version": 2,
  "appId": "app_ce8d63cdd7cb45d39a60",
  "model": "RGfoyOBb",
  "title": "Hotel Booking Health",
  "decision": "Are hotel bookings succeeding, and where are failures concentrated?",
  "persona": "pm",
  "template": "report",
  "time": {
    "column": "timestamp",
    "from": "2026-08-01",
    "to": "tomorrow",
    "grain": "day"
  },
  "measures": [
    {
      "id": "successful",
      "column": "total_successful_bookings_v2",
      "label": "Successful bookings",
      "format": "number",
      "good": "up",
      "role": "primary"
    },
    {
      "id": "failed",
      "column": "total_failed_bookings_v2",
      "label": "Failed bookings",
      "format": "number",
      "good": "down"
    },
    {
      "id": "failure_rate",
      "column": "total_booking_failure_rate_overall_v2",
      "label": "Failure rate",
      "format": "rate",
      "good": "down"
    },
    {
      "id": "offers",
      "column": "all_offers",
      "label": "Offers",
      "format": "number",
      "good": "up"
    }
  ],
  "dimensions": [
    {
      "field": "brand_owner_name_grouped",
      "label": "Brand owner"
    },
    {
      "field": "city_name",
      "label": "City"
    },
    {
      "field": "failureType",
      "label": "Failure type"
    }
  ],
  "questions": [
    {
      "say": "How many bookings succeed and fail, and which way is it moving?",
      "recipe": "kpis"
    },
    {
      "say": "What stands out this week?",
      "recipe": "narrative"
    },
    {
      "say": "How have successes and the failure rate moved since August?",
      "recipe": "trend",
      "bind": {
        "measures": [
          "successful",
          "failure_rate"
        ]
      }
    },
    {
      "say": "Which brand owners and cities carry the volume?",
      "recipe": "breakdown",
      "bind": {
        "dims": [
          "brand_owner_name_grouped",
          "city_name"
        ],
        "limit": 10
      }
    },
    {
      "say": "Which brand owners have the best and worst failure rate?",
      "recipe": "ranking",
      "bind": {
        "dim": "brand_owner_name_grouped",
        "measure": "failure_rate"
      }
    },
    {
      "say": "Give me the numbers by brand owner and failure type.",
      "recipe": "table",
      "bind": {
        "dims": [
          "brand_owner_name_grouped",
          "failureType"
        ],
        "limit": 30
      }
    }
  ],
  "controls": [
    {
      "kind": "measure"
    },
    {
      "kind": "dimensions"
    }
  ],
  "words": {
    "successful": "Successful bookings",
    "failed": "Failed bookings",
    "failure_rate": "Failure rate",
    "offers": "Offers"
  },
  "rules": {
    "compare_periods": 7
  },
  "theme": {
    "accent": "purple",
    "follow": "system"
  }
}
