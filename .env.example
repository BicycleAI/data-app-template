# A view token for local development, so `npm run dev` can run real queries
# against the local service. Mint one with:
#
#   curl -s -X POST localhost:8099/api/data-apps/apps/<appId>/view-tokens \
#     -H 'X-Dev-User-Id: dev-user-0000-0000-0000-000000000000' \
#     -H 'X-Dev-Tenant-Id: dev-tenant' -H 'content-type: application/json' -d '{}'
#
# View tokens are short-lived by design; re-mint when queries start failing
# with token_expired.
VITE_BDA_TOKEN=
